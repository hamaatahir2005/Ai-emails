# Generate random secrets; never commit .env.
DATABASE_URL=postgresql+psycopg://emailos:REPLACE_PASSWORD@postgres:5432/emailos
POSTGRES_PASSWORD=REPLACE_PASSWORD
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
UNSUBSCRIBE_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
WEBHOOK_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
PUBLIC_URL=https://email.example.com
SENDING_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
# Optional authorized IMAP mailbox, TLS only. Prefer app password and least privilege.
MAILBOX_HOST=
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_PORT=993
MAILBOX_FOLDER=INBOX
# Optional FCM application-default credential file; mount read-only in worker.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
